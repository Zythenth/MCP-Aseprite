{
  "name": "aseprite-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Aseprite pixel art creation, editing, and inspection",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aseprite-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "extension",
    "lua",
    "README.md",
    "LICENSE",
    "examples",
    "install.ps1",
    "start.ps1"
  ],
  "scripts": {
    "build": "tsc",
    "package:extension": "node scripts/package-extension.mjs",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
